<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Backup S3 Manager"
      Manufacturer="BackupS3"
      Version="23.0.15"
      UpgradeCode="6FB62AC6-9B68-4A57-B01A-4E1F21A7B123"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Backup S3 Manager is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BackupS3 Manager" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Backup S3 Manager" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="BackupS3 Manager">
        <Component Id="ApplicationShortcut" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="Backup S3 Manager"
                    Description="Backup S3 Manager"
                    Target="[INSTALLFOLDER]BackupS3Manager.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuAppFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\BackupS3Manager"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
